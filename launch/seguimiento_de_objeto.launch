<launch>
    <node pkg="kinect_ros2" exec="kinect_ros2_node" name="kinect_ros2_node" />
    <include file="$(find-pkg-share kobuki_node)/launch/kobuki_node-launch.py" />
    
    <node pkg="lab2" exec="detector_de_objeto.py" name="detector_de_objeto" output="screen" />
    <node pkg="lab2" exec="seguidor_de_objeto.py" name="seguidor_de_objeto" output="screen" />
</launch>
